# Browser-safe Supabase connection values
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Use the Publishable key from Supabase Dashboard > Connect (recommended).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Optional legacy fallback only. Do not set both unless migrating an existing project.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Never prefix this value with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Local: http://localhost:3000 / Production: https://your-domain.example
NEXT_PUBLIC_APP_URL=http://localhost:3000
